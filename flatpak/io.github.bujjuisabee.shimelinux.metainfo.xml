<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.bujjuisabee.shimelinux</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>BSD-3-Clause</project_license>
    <name>ShimeLinux</name>
    <summary>Shimeji desktop pet</summary>
    <developer id="io.github.bujjuisabee">
        <name>Bujju</name>
    </developer>
    <description>
        <p>ShimeLinux is a Linux port of Shimeji-ee desktop pet, an application which lets you have little characters (called Shimeji) walking around on your desktop.</p>
        <p>Features:</p>
        <ul>
            <li>It is compatible with any Shimeji made for the latest version of Shimeji-ee</li>
            <li>It supports many Linux desktop environments and tiling window managers</li>
            <li>It supports interactive windows on KDE Plasma</li>
        </ul>
    </description>
    <launchable type="desktop-id">io.github.bujjuisabee.shimelinux.desktop</launchable>
    <keywords>
        <keyword>desktop-pet</keyword>
        <keyword>shimeji</keyword>
        <keyword>shimeji-ee</keyword>
    </keywords>
    <branding>
        <color type="primary" scheme_preference="light">#84B0DB</color>
        <color type="primary" scheme_preference="dark">#3c83c5</color>
    </branding>
    <content_rating type="oars-1.1"/>
    <url type="homepage">https://github.com/BujjuIsABee/shimelinux</url>
    <url type="bugtracker">https://github.com/BujjuIsABee/shimelinux/issues</url>
    <url type="vcs-browser">https://github.com/BujjuIsABee/shimelinux</url>
    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/BujjuIsABee/shimelinux/d6163999affacd1ba9b559e043d9588570984074/img/chooser.png</image>
            <caption>The ShimeLinux image set chooser</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/BujjuIsABee/shimelinux/d6163999affacd1ba9b559e043d9588570984074/img/settings.png</image>
            <caption>A couple of Shimeji climbing on the ShimeLinux settings window</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/BujjuIsABee/shimelinux/d6163999affacd1ba9b559e043d9588570984074/img/windowed.png</image>
            <caption>ShimeLinux in windowed mode</caption>
        </screenshot>
    </screenshots>
    <releases>
        <release version="1.3.4" date="2026-10-06">
            <url type="details">https://github.com/BujjuIsABee/shimelinux/releases/tag/v1.3.4</url>
            <description>
                <p>Changelog:</p>
                <ul>
                    <li>Reduced memory usage by about 40%.</li>
                    <li>Fixed a bug where custom behavior names in the "Set Behavior" popup and "Reveal Statistics" window would not have spaces between words.</li>
                    <li>Fixed a bug where the path to the <code>actions.xml</code> and <code>behaviors.xml</code> files would be displayed incorrectly in the Shimeji chooser if a directory other than <code>~/.config/shimelinux</code> was used.</li>
                    <li>Added better error messages for common errors in the Wayland environment.</li>
                    <li>Removed the "Menu Scaling" setting and the buttons in the "About" tab in settings as they did not work properly.</li>
                </ul>
            </description>
        </release>
    </releases>
    <recommends>
        <control>pointing</control>
    </recommends>
    <supports>
        <control>keyboard</control>
    </supports>
</component>
